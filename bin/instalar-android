#!/data/data/com.termux/files/usr/bin/bash
# instalar-android · una línea, y Aurelius habla.
#
# sistema: MVP · instalador para Termux (Android). Sin dependencias más allá de
# lo que este propio guion instala.
#
# QUÉ HACE, EN ORDEN, Y POR QUÉ ESE ORDEN
# ---------------------------------------
# 1. Las herramientas mínimas (git, python, y el compilador solo si hace falta).
# 2. El producto.
# 3. El motor. **Se compila en el teléfono**, y eso es una decisión, no una
#    pereza: hoy no hay un binario aarch64 con su sha256 firmado en el catálogo,
#    y bajar un ejecutable sin huella firmada es exactamente lo que este árbol
#    no hace con el cerebro ni con la voz. Cuando exista esa firma, este guion
#    se lo bajará en segundos y compilar quedará como camino soberano.
# 4. El cerebro y la voz, por el ritual del propio producto, que verifica su
#    sha256 contra el catálogo y borra lo que no cuadre.
#
# LO QUE NO HACE
# --------------
# * No pide permisos de Android, no toca ajustes y no escribe fuera de Termux.
# * No decide por ti: la descarga del cerebro (2,3 GiB) la ofrece el producto y
#   la aceptas tú, con su licencia y su huella delante.
# * No promete lo que no puede: si el compilador falla, lo dice y para. Un
#   instalador que sigue después de un error deja una casa a medias que parece
#   entera.
set -u

AZUL='\033[38;5;141m'; TENUE='\033[38;5;103m'; FIN='\033[0m'
paso()  { printf "${AZUL}··${FIN} %s\n" "$1"; }
nota()  { printf "${TENUE}   %s${FIN}\n" "$1"; }
muere() { printf "\n✗ %s\n" "$1" >&2; exit 1; }

REPO="${AURELIUS_REPO:-https://github.com/piskyRpapalo/aurelius}"
DESTINO="${AURELIUS_DESTINO:-$HOME/aurelius}"
LLAMA="$HOME/.llama.cpp"
MOTOR="llama-completion"

printf "\n${AZUL}AURELIUS${FIN} · instalación en Android\n\n"

# --- 1 · herramientas ------------------------------------------------------
paso "Herramientas"
pkg install -y git python cmake clang >/dev/null 2>&1 \
    || muere "no pude instalar las herramientas. ¿Hay red?"
nota "git, python, cmake y clang"

# --- 2 · el producto -------------------------------------------------------
paso "El producto"
if [ -d "$DESTINO/.git" ]; then
    git -C "$DESTINO" pull --ff-only >/dev/null 2>&1 || nota "sin cambios nuevos"
    nota "ya estaba en $DESTINO; actualizado"
else
    git clone --depth 1 "$REPO" "$DESTINO" >/dev/null 2>&1 \
        || muere "no pude clonar $REPO"
    nota "clonado en $DESTINO"
fi

# --- 3 · el motor ----------------------------------------------------------
# Se compila aquí porque no hay binario firmado que bajar. Ver la cabecera.
if command -v "$MOTOR" >/dev/null 2>&1; then
    paso "El motor"
    nota "ya estaba: $(command -v $MOTOR)"
else
    paso "El motor · se compila aquí (tarda; es una vez)"
    nota "no hay binario firmado para aarch64, y sin huella firmada no se baja"
    if [ ! -d "$LLAMA/.git" ]; then
        git clone --depth 1 https://github.com/ggml-org/llama.cpp "$LLAMA" \
            >/dev/null 2>&1 || muere "no pude clonar llama.cpp"
    fi
    cmake -S "$LLAMA" -B "$LLAMA/build" -DCMAKE_BUILD_TYPE=Release \
          -DLLAMA_CURL=OFF -DGGML_NATIVE=OFF >/dev/null 2>&1 \
        || muere "cmake no pudo preparar la compilación"
    cmake --build "$LLAMA/build" --target "$MOTOR" -j"$(nproc)" >/dev/null 2>&1 \
        || muere "la compilación falló. No sigo: media casa parece una casa."
    BINARIO="$(find "$LLAMA/build" -name "$MOTOR" -type f | head -1)"
    [ -n "$BINARIO" ] || muere "compiló y no encuentro el binario"
    mkdir -p "$PREFIX/bin"
    ln -sf "$BINARIO" "$PREFIX/bin/$MOTOR"
    nota "$MOTOR listo"
fi

# --- 4 · el cerebro y la voz, por el ritual del producto -------------------
paso "El cerebro y la voz"
nota "los ofrece Aurelius, con su licencia y su huella delante"
nota "la verificación del sha256 la hace él, no este guion"

printf "\n${AZUL}Listo.${FIN} Lo que sigue lo decides tú:\n\n"
printf "  cd %s\n" "$DESTINO"
printf "  python3 aurelius.py          %s\n" "· crear tu memoria"
printf "  python3 aurelius.py --charla %s\n\n" "· hablar, si hay cerebro"
